[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

linux.debug.x86_64 = "res://../target/debug/libmw_godot.so"
linux.release.x86_64 = "res://../target/release/libmw_godot.so"
windows.debug.x86_64 = "res://../target/debug/mw_godot.dll"
windows.release.x86_64 = "res://../target/release/mw_godot.dll"
