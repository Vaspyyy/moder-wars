{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"files": {
		"includes": [
			"*.js",
			"*.html",
			"*.css",
			"src/**/*.js",
			"workers/**/*.js",
			"styles/**/*.css"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"useButtonType": "off",
				"noSvgWithoutTitle": "off"
			},
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	}
}
